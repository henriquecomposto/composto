{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "portuguese",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm ls *)",
      "Bash(npm outdated*)",
      "Bash(npm audit)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git describe*)",
      "Bash(npx supabase migration new *)",
      "Bash(npx supabase migration list*)",
      "Bash(npx supabase projects list)",
      "Bash(npx supabase --version)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git tag -a *)",
      "Bash(npx supabase db push*)",
      "Bash(npx supabase db dump*)",
      "Bash(npx supabase link*)",
      "Bash(npx supabase migration repair*)",
      "Bash(npx supabase config push*)",
      "Bash(npx supabase secrets *)",
      "Bash(npx supabase storage rm*)",
      "Bash(npx supabase functions deploy*)",
      "Bash(npx vercel*)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(npm audit fix*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(npx supabase db reset*)",
      "Bash(npx supabase projects delete*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protege-env.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pede-confirmacao.sh\""
          }
        ]
      }
    ]
  }
}
