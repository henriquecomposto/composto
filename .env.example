# Modelo do arquivo .env do Composto (este arquivo VAI para o Git; não tem segredos).
# Como usar: copie para ".env" e preencha os valores.
# Valores em: painel do Supabase → Project Settings → API Keys

# --- Supabase (público: pode ir para o navegador) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (secreto: SOMENTE no servidor; jamais com NEXT_PUBLIC_) ---
SUPABASE_SECRET_KEY=

# --- Banco de dados (senha do Postgres) ---
SUPABASE_DB_PASSWORD=
